

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Page</title>
  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }
  </style>
</head>
<body>

  <h1>URL Shortener</h1>
  <nav style="margin-bottom: 20px;">
    <a href="/login" style="margin-right: 10px;">Login</a>
    <a href="/signup">Signup</a>
  </nav>

  <% if (id) { %>
    <div style="background-color: #f0f0f0; padding: 10px; margin-bottom: 20px; border-radius: 5px;">
      <p><strong>✓ URL Generated Successfully!</strong></p>
      <p>
        Short URL:
        <a href="http://localhost:8001/url/<%= id %>" target="_blank" style="font-weight: bold; color: blue;">
          http://localhost:8001/url/<%= id %>
        </a>
      </p>
    </div>
  <% } %>

  <div>
    <form method="POST" action="/url">
      <label>Enter Your Original URL</label>
      <input type="text" name="url" placeholder="https://example.com" required />
      <button type="submit">Generate</button>
    </form>
  </div>

  <div>
    <% if (urls && urls.length > 0) { %>
      <table border="1" cellpadding="5">
        <thead>
          <tr>
            <th>S.no.</th>
            <th>ShortId</th>
            <th>Redirect URL</th>
            <th>Clicks</th>
          </tr>
        </thead>
        <tbody>
          <% urls.forEach((url, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= url.shortId %></td>
              <td><%= url.redirectURL %></td>
              <td><%= url.visitHistory.length %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

</body>
</html>
